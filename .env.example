# PostgreSQL connection string (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drink_votes
# Port the server listens on
PORT=3000
# Time zone used for outing times
APP_TZ=Asia/Ho_Chi_Minh
# Default voting close time, 24-hour HH:mm
DEFAULT_CLOSE_AT=16:00
# Minimum people Going at the close; fewer cancels the outing (positive integer)
MIN_PEOPLE=3
